{"nodes": [{"id": "designdoc_frontend_design_system", "label": "Saarthi Mail Frontend Design System Doc", "file_type": "document", "source_file": "designdoc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI should feel calm, intelligent, modern, and hackathon-winning while maintaining strong usability and smooth motion."}, {"id": "designdoc_omni_design_system", "label": "Omni Platform Design System (palette, radii, 4px spacing rhythm)", "file_type": "concept", "source_file": "designdoc.md", "source_location": "Design System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraining to a fixed Omni palette, an allowed radius set (4/6/8/12/16/pill), and a strict 4px spacing rhythm enforces visual consistency across the app."}, {"id": "designdoc_four_panel_workspace", "label": "Four-Panel Workspace Layout (Sidebar | List | Detail | AI Panel)", "file_type": "concept", "source_file": "designdoc.md", "source_location": "Layout Structure / Responsive Behavior", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gmail-inspired productivity layout: desktop shows the full four panels, tablet collapses the sidebar and docks the AI panel, mobile degrades to a single-column flow with a drawer and bottom navigation."}, {"id": "designdoc_selective_glassmorphism", "label": "Selective Glassmorphism", "file_type": "rationale", "source_file": "designdoc.md", "source_location": "Surface Style / Glassmorphism Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Glass surfaces are limited to the AI panel, auth screen, and floating controls \u2014 applying frosted blur everywhere, or using heavy shadows, dark neumorphism, or excessive gradients, would break the calm premium feel."}, {"id": "designdoc_controlled_motion_system", "label": "Controlled Motion System (150ms / 300ms Framer Motion)", "file_type": "rationale", "source_file": "designdoc.md", "source_location": "Motion System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion is expressive but restricted to 150ms and 300ms durations and productivity-focused uses (sidebar, card reveal, selection, AI stagger, skeletons); bouncy, over-animated, or long transitions are avoided so the UI stays fast and calm."}, {"id": "designdoc_command_palette", "label": "Command Palette", "file_type": "concept", "source_file": "designdoc.md", "source_location": "Command Palette", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard-first entry point for search, compose, navigation, archive, mark important, toggling the AI panel, and settings."}, {"id": "designdoc_accessibility_requirements", "label": "Accessibility Requirements", "file_type": "concept", "source_file": "designdoc.md", "source_location": "Accessibility", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard navigation, visible focus rings, reduced-motion support, high-contrast text, and screen reader labels are required, which constrains the motion system."}, {"id": "designdoc_mvp_mocked_data_first", "label": "Mocked-Data-First MVP Scope", "file_type": "rationale", "source_file": "designdoc.md", "source_location": "MVP Scope", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build auth, inbox, detail, AI panel, responsive layout, and motion polish against mocked data first; backend integration and Gmail APIs are deliberately deferred so the demo-critical UI lands early."}, {"id": "designdoc_core_routes", "label": "Core Routes (/auth, /inbox, /mail/:id, /priority, /settings)", "file_type": "concept", "source_file": "designdoc.md", "source_location": "Core Pages", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desig